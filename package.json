    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@types/yauzl": "^3.4.0",
    "cheerio": "^1.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socks-proxy-agent": "^8.0.5",
    "undici": "^6.28.1",
    "yauzl": "^3.4.0"
